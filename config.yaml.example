# config.yaml.example - Copy this structure to config.yaml and configure local boundaries
gateway:
  token_ttl_seconds: 600

logging:
  log_directory: "logs"
  log_filename_pattern: "{name}_{date}.jsonl"
  log_base_name: "audit_log"

security:
  master_api_key: "GENERATE_A_SECURE_SECRET_HERE"

detectors:
  email_scanner_enabled: true
  credit_card_scanner_enabled: true
  infrastructure_scanner_enabled: true

network:
  ip_whitelist_enabled: false
  allowed_ip_networks:
    - "127.0.0.1/32"

webhooks:
  webhook_streaming_enabled: false
  target_destination_url: ""

chat_notifications:
  enabled: false
  provider: "slack"  # Options: "slack" or "teams"
  webhook_url: ""
  min_severity_level: "HIGH"
